# ==============================================================================
# TITANFORGE GYM MANAGEMENT SOFTWARE - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# DO NOT COMMIT REAL SECRETS OR PASSWORDS TO SOURCE CONTROL.
# Duplicate this file as '.env' for local development or input these key-value
# pairs into your Render / Vercel deployment dashboards.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT & PORT
# ------------------------------------------------------------------------------
NODE_ENV="production"
PORT=3000

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL for Production, SQLite for Local Dev)
# ------------------------------------------------------------------------------
# Production (Render, Supabase, Neon, Railway PostgreSQL):
DATABASE_URL="postgresql://username:password@hostname:5432/dbname?sslmode=require"

# Local Development (SQLite fallback):
# DATABASE_URL="file:./dev.db"

# ------------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION SECRETS
# ------------------------------------------------------------------------------
# Cryptographically secure key used to sign and verify JWT authentication tokens.
# Must be at least 32 random characters (e.g. generate with: openssl rand -base64 32).
AUTH_SECRET="change-this-to-a-cryptographically-secure-random-32-byte-secret"
JWT_SECRET="change-this-to-a-cryptographically-secure-random-32-byte-secret"

# ------------------------------------------------------------------------------
# 4. CROSS-ORIGIN RESOURCE SHARING (CORS) & BACKEND PROXY
# ------------------------------------------------------------------------------
# Set on the Render backend to authorize requests from your Vercel frontend domain.
# Multiple comma-separated URLs or wildcard subdomains (*.vercel.app) are supported.
CORS_ORIGIN="https://your-gym-app.vercel.app,http://localhost:3000,http://localhost:5173"

# ------------------------------------------------------------------------------
# 5. FRONTEND API BASE URL (Configured on Vercel)
# ------------------------------------------------------------------------------
# Point this to your live Render backend URL when deploying the frontend on Vercel.
# Leave empty if the frontend and backend are served from the same domain.
VITE_API_URL="https://gym-management-api.onrender.com"

# ------------------------------------------------------------------------------
# 6. TRANSACTIONAL EMAIL (BREVO SMTP RELAY)
# ------------------------------------------------------------------------------
# Used for automated welcome notices, payment receipt dispatch, and expiry reminders.
# Obtain these from Brevo (Sendinblue) -> Transactional -> Settings -> Configuration.
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT=587
SMTP_USER="your-brevo-smtp-login-email@example.com"
SMTP_PASSWORD="your-brevo-master-smtp-key"
SMTP_FROM="noreply@yourgymdomain.com"
SMTP_FROM_NAME="TitanForge Fitness & Gym"

# ------------------------------------------------------------------------------
# 7. SEED ADMINISTRATOR CREDENTIALS
# ------------------------------------------------------------------------------
# Used by 'npm run db:seed' to provision the initial Super Administrator account.
ADMIN_EMAIL="admin@yourgym.com"
ADMIN_PASSWORD="ReplaceWithStrongAdminPassword123!"

# ------------------------------------------------------------------------------
# 8. GEMINI AI STUDIO INTEGRATION (OPTIONAL)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=""
