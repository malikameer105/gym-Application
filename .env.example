# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Database connection URL (e.g. file:./dev.db for SQLite or postgresql://... for PostgreSQL)
DATABASE_URL="file:./dev.db"

# Authentication secret key for signing JWT session tokens
AUTH_SECRET="gym-mgmt-super-secret-key-32-chars-minimum"

# Seed administrator credentials
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="Admin@Password123!"
