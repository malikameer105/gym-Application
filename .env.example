# ==============================================================================
# TITANFORGE GYM MANAGEMENT SOFTWARE - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# DO NOT COMMIT REAL SECRETS OR PASSWORDS TO SOURCE CONTROL.
# Duplicate this file as '.env' for local development or input these key-value
# pairs into your Railway / Render / Vercel deployment dashboards.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT & PORT (Backend: Railway / Render)
# ------------------------------------------------------------------------------
NODE_ENV="production"
# Dynamic port assigned by Railway/Render (do not hardcode in cloud; defaults to 3000 locally)
PORT=3000

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL for Production, SQLite for Local Dev)
# ------------------------------------------------------------------------------
# Production PostgreSQL Connection URL (Neon, Railway PostgreSQL, Supabase, Render):
DATABASE_URL="postgresql://username:password@hostname:5432/dbname?sslmode=require"

# ------------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION SECRETS (Backend)
# ------------------------------------------------------------------------------
# Cryptographically secure key used to sign and verify JWT authentication tokens.
# Generate with: openssl rand -base64 32
JWT_SECRET="change-this-to-a-cryptographically-secure-random-32-byte-secret"
AUTH_SECRET="change-this-to-a-cryptographically-secure-random-32-byte-secret"

# ------------------------------------------------------------------------------
# 4. CROSS-ORIGIN RESOURCE SHARING (CORS) & FRONTEND DOMAIN (Backend)
# ------------------------------------------------------------------------------
# Whitelist your live Vercel frontend URL
FRONTEND_URL="https://gymapplicationbymalik.vercel.app"
CORS_ORIGIN="https://gymapplicationbymalik.vercel.app,http://localhost:3000,http://localhost:5173"

# ------------------------------------------------------------------------------
# 5. FRONTEND API BASE URL (Configured on Vercel)
# ------------------------------------------------------------------------------
# Set in Vercel Project Settings -> Environment Variables
# Target Railway backend:
VITE_API_URL="https://gymmanagement987.up.railway.app"

# ------------------------------------------------------------------------------
# 6. TRANSACTIONAL EMAIL (BREVO SMTP RELAY) (Backend)
# ------------------------------------------------------------------------------
# Brevo (Sendinblue) credentials for welcome emails, payment receipts, and expiry alerts.
# Obtain from: Brevo Dashboard -> SMTP & API -> SMTP
BREVO_SMTP_HOST="smtp-relay.brevo.com"
BREVO_SMTP_PORT=587
BREVO_SMTP_USER="your-brevo-login-email@example.com"
BREVO_SMTP_PASSWORD="your-brevo-master-smtp-key"
MAIL_FROM_EMAIL="noreply@yourgymdomain.com"
MAIL_FROM_NAME="TitanForge Fitness & Gym"

# Legacy / Alias format also supported:
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT=587
SMTP_USER="your-brevo-login-email@example.com"
SMTP_PASSWORD="your-brevo-master-smtp-key"
SMTP_FROM="noreply@yourgymdomain.com"
SMTP_FROM_NAME="TitanForge Fitness & Gym"

# ------------------------------------------------------------------------------
# 7. SEED ADMINISTRATOR CREDENTIALS (Optional, used by 'npm run db:seed')
# ------------------------------------------------------------------------------
ADMIN_EMAIL="admin@yourgym.com"
ADMIN_PASSWORD="ReplaceWithStrongAdminPassword123!"
